// 1. модификаторы: pub/priv/prot/stat/const/abstr/sync/vol/trans + cls/ext/impl/interf/noret/ret
pub cls Full ext Object impl Runnable {
    priv str secret = "x"
    prot int protField = 1
    stat const VER = "2.0"
    sync noret syncMethod() { print("sync") }
    vol int volField = 0
    trans str tmp = "t"
}

// 2. классы
pub cls MyClass ext Parent impl Interface1, Interface2 {}
const cls Config {}
abstr cls Shape { abstr int area() }
interf Animal { pub noret sound() }
pub cls Outer { pub cls Inner {} }

