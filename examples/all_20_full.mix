// 12 дженерик + 13 enum
pub cls Box<T> { var content pub noret set(T v){ content=v } pub T get(){ ret content } }
enum Color { RED, GREEN, BLUE }
enum Status { ACTIVE("активен"), INACTIVE("неактивен") }

pub cls AllFull {
    pub noret runAll() {
        // 5 условные
        var age = 20
        if age > 18 { print("adult") }
        if age > 18 { print("adult2") } else { print("kid") }
        if age < 13 { print("kid") } elif age < 18 { print("teen") } else { print("adult") }
        if age > 18 -> print("OK")
        var st = age > 18 ? "yes" : "no"
        print("ternary {st}")

        // 6 циклы
        for (var i=0; i<2; i++) { print("for {i}") }
        for item : [1,2,3] { print("each {item}") }
        var w = 2
        while w > 0 { print("while {w}") w = w - 1 }
        do { print("do") } while false

        // 7 print + строки все методы
        var txt = " Hello "
        print("Привет {txt} {age}")
        print(txt.lower())
        print(txt.upper())
        print(txt.trim())
        print(txt.capitalize())
        print(txt.replace("l","L"))
        print(txt.contains("ell"))
        print(txt.startsWith(" He"))
        print(txt.endsWith("lo "))
        print(txt.substring(1,3))
        print(txt.split(" "))
        print(txt.charAt(0))
        print(txt.index("ell"))
        print(txt.isEmpty())
        print(txt.repeat(2))
        print(txt.reverse())
        print("a\nb\tc \"q\" C:\\path")

        // 9 массивы
        var nums = [1,2,3,4,5]
        var names = ["Анна","Иван"]
        var matrix = [[1,2],[3,4]]
        var empty = []
        print("nums0 {nums[0]}")
        print("len {len(nums)}")
        var lst = List()
        lst.add("x")
        var mp = Map()
        mp.put("k","v")
        var mp2 = {"name": "Иван", "age": 25}
        var st2 = Set()
        st2.add(1)

        // 10 встроенные все
        print("sum {sum(5,3)}")
        print("sub {sub(5,3)}")
        print("mult {mult(5,3)}")
        print("div {div(10,2)}")
        print("mod {mod(10,3)}")
        print("pow {pow(2,3)}")
        print("sqrt {sqrt(16)}")
        print("abs {abs(-5)}")
        print("min {min(5,3)}")
        print("max {max(5,3)}")
        print("avg {avg(5,3)}")
        print("inc {inc(5)} dec {dec(5)}")
        print("strlen {strlen(txt)}")
        print("concat {concat(\"a\",\"b\")}")
        print("substr {substr(txt,1,3)}")
        print("upper {upper(txt)}")
        print("len {len([1,2,3])} first {first([1,2,3])} last {last([1,2,3])}")
        print("append {append([1,2],3)}")
        print("reverse {reverse([1,2,3])} sort {sort([3,1,2])} unique {unique([1,2,2,3])}")
        print("and {and(true,false)} or {or(true,false)} not {not(true)} xor {xor(true,false)}")
        print("round {round(10.7)} floor {floor(10.7)} ceil {ceil(10.3)}")
        print("isInt {isInt(5)} isString {isString(txt)} isArray {isArray(nums)} isNull {isNull(null)} typeOf {typeOf(5)}")
        print("toInt {toInt(\"123\")} toFloat {toFloat(\"10.5\")}")
        print("randint {randint(10)} randint2 {randint(5,10)} randfloat {randfloat()} randfloat5 {randfloat(5.0)} randfloat2 {randfloat(1.5,4.5)}")
        print("choice {choice([1,2,3])} choices {choices([1,2,3],2)} shuffle {shuffle([1,2,3])} randbool {randbool()} randchar {randchar()} randstring {randstring(5)} randrange {randrange(5)}")
        println(5)
        sleep(5)
        print("now {now()}")

        // 11 исключения
        try { var x = 10 / 0 } catch (Exception e) { print("catch {e}") } finally { print("finally") }
        try { print("t2") } catch e { print("e {e}") }

        // 14 лямбды
        var fn = (a, b) -> a + b
        print("fn {fn(5,3)}")

        // 17 память
        var obj = alloc(10)
        var arr = allocArray(10)
        free(obj)
        freeArray(arr)
        var obj2 = realloc(obj, 20)
        var ptr = smart_ptr(obj)
        print(meminfo())
        print("memused {memused()}")
        gc()
        cleanup()

        // 19 доп
        print(typeof(obj))
        print(classname(obj))
    }
}

