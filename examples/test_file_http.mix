// test_file_http.mix - тест File/Http (MVM-валидный)
print("=== File/Http ===")
write("misha_test.txt", "Hello Misha File")
print("write done")
var e = exists("misha_test.txt")
print("exists {e}")
var c = read("misha_test.txt")
print("read: {c}")
appendFile("misha_test.txt", "\nappend")
print("append done")
var c2 = read("misha_test.txt")
print("read2: {c2}")
var files = listFiles(".")
print("listFiles {files}")
print("done file/http")
